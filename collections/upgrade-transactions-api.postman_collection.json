          "name": "Authorize Transaction",
          "request": {
            "name": "Authorize Transaction",
            "description": {
              "content": "Using the order_id from the checkout flow, an authorization is the first step using the Transaction API. Once an authorization is submitted against an Order, a new Transaction is created. Once a transaction is authorized you have up to 7 days to submit capture requests; after expiration the remaining amount is automatically voided (see authorization_expiration on the Transaction object).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "transactions"
              ],
              "host": [
                "{{baseUrl}}"
