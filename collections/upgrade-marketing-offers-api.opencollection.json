{
  "opencollection": "1.0.0",
  "info": {
    "name": "Flex Pay API (Upgrade) Marketing Offers API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://partner.upgrade.com/api/auth/v1/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Marketing Offers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get offers",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://partner.upgrade.com/api/checkout/v1/marketing/offers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates marketing offers (monthly-payment pricing and availability) for a list of orders, for display early in the shopping flow."
        }
      ]
    }
  ],
  "bundled": true
}